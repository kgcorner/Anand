# Export these variables in your shell or deployment environment before running the backend.
# The server does not automatically load .env files.

# HTTP port the API listens on
PORT=8080

# Interface to bind to (use 127.0.0.1 to keep it local-only)
HOST=0.0.0.0

# SQLite database file (relative paths are resolved from the working directory)
DATABASE_PATH=./data/anand.sqlite

# Secret used to HMAC-sign session tokens. REQUIRED in production.
# Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-secret-change-in-production

# Session token lifetime in seconds (default 2592000 = 30 days)
SESSION_TTL_SECONDS=2592000

# Comma-separated list of origins allowed by CORS (default: Angular dev server)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
