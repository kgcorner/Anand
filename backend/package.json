{
  "name": "anand-backend",
  "version": "0.1.0",
  "description": "Anand (HealthPulse) backend API - TypeScript / Node.js",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
